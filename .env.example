AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://lanyard-api

# trusted-agent: files:read, files:write, deploy:run
TRUSTED_CLIENT_ID=
TRUSTED_CLIENT_SECRET=

# intern-agent: files:read only
INTERN_CLIENT_ID=
INTERN_CLIENT_SECRET=

# Optional: remove a revoked agent's Auth0 grant (M2M app for the Auth0 Management API with
# read:client_grants, create:client_grants, delete:client_grants)
AUTH0_ADMIN_CLIENT_ID=
AUTH0_ADMIN_CLIENT_SECRET=

# Optional: workload identity for agents on AWS (IAM roles in this account; see policy.py)
LANYARD_AWS_ACCOUNT=
LANYARD_SIGNING_KEY=

# Optional: Bedrock Guardrails scan of tool responses
AWS_PROFILE=
AWS_REGION=us-east-1
LANYARD_GUARDRAIL_ID=
LANYARD_GUARDRAIL_VERSION=DRAFT
# LANYARD_GUARDRAIL_FAIL=closed   # or "open" to pass responses through if the scan is unavailable

# Optional: Amazon Verified Permissions policy store (python -c "from lanyard.avp import create_store; ...")
LANYARD_AVP_POLICY_STORE=
# Optional: AWS KMS key (RSA_2048, SIGN_VERIFY) that signs Lanyard-issued tokens
LANYARD_KMS_KEY_ID=
