AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://lanyard-api

# trusted-agent: files:read, files:write, deploy:run
TRUSTED_CLIENT_ID=
TRUSTED_CLIENT_SECRET=

# intern-agent: files:read only
INTERN_CLIENT_ID=
INTERN_CLIENT_SECRET=

# Optional: Bedrock Guardrails scan of tool responses
AWS_PROFILE=
AWS_REGION=us-east-1
LANYARD_GUARDRAIL_ID=
LANYARD_GUARDRAIL_VERSION=DRAFT
# LANYARD_GUARDRAIL_FAIL=closed   # or "open" to pass responses through if the scan is unavailable
